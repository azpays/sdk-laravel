{
    "name": "azpays/sdk-laravel",
    "description": "Official Laravel package for the AzPays crypto payment platform",
    "keywords": [
        "azpays",
        "laravel",
        "crypto",
        "payments",
        "payment-gateway",
        "bitcoin",
        "ethereum",
        "tron",
        "usdt"
    ],
    "homepage": "https://azpays.net",
    "license": "MIT",
    "authors": [
        {
            "name": "AzPays Team",
            "email": "support@azpays.net",
            "homepage": "https://azpays.net"
        }
    ],
    "require": {
        "php": "^8.1",
        "azpays/sdk-php": "^1.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AzPays\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AzPays\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AzPays\\Laravel\\AzpaysServiceProvider"
            ],
            "aliases": {
                "AzPays": "AzPays\\Laravel\\Facades\\AzPays"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
